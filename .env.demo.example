# Settings for `pnpm build:demo` (one HTML file per app, published on claude.ai).
# Copy to .env.demo.local (git-ignored) and fill in. These are ids and links, not secrets.

# Neon branch each published demo reads and writes (docs/CORE_RULES.md rule 6):
#   Admin Console: may use main (leave empty for main).
#   Partner portal and customer apps: their own branch, never main.
VITE_NEON_BRANCH_ADMIN=
VITE_NEON_BRANCH_PARTNER=
VITE_NEON_BRANCH_CUSTOMER=

# Optional: the published claude.ai links of the apps, so cross-app links (support sessions,
# a dealer's customer sign-in pages) open the right demo.
VITE_DEMO_URL_ADMIN=
VITE_DEMO_URL_PARTNER=
VITE_DEMO_URL_CUSTOMER=
