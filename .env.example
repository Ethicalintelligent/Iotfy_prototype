# Copy to .env.local (never commit .env.local).
# Neon connection string for YOUR branch: console.neon.tech → iotify-prototypes → Connect → branch → role.
DATABASE_URL=
# neon-dev (laptop) | claude-mcp (published claude.ai demo) | api (future Java backend)
VITE_DATA_MODE=neon-dev
# Only for claude-mcp (published demos): which Neon project and branch the connector uses (ids, not secrets).
# VITE_NEON_PROJECT=empty-sea-69531006
# VITE_NEON_BRANCH=br-polished-moon-bdwryps8
# Browser tests only (pnpm e2e): a SEPARATE Neon branch (e.g. test/e2e). Tests write to it and never use DATABASE_URL.
TEST_DATABASE_URL=
