      ["Issued By", "text"],
      ["Issued On", "date"],
      ["Valid Until", "date"],
      ["Status", "enum", ["Pending", "Issued", "Expired", "Rejected"]]
    ],
    "group": "Business"
  },
  "Sites": {
    "title": "Sites",
    "prefix": "ST",
    "label": ["Name"],
    "fields": [
      ["ID", "id"],
      ["Company ID", "ref", "Companies"],
      ["Name", "text"],
      ["Address", "text"],
      ["Status", "enum", ["Active", "Inactive"]]
    ],
    "group": "Business"
  },
  "Zones": {
    "title": "Zones",
    "prefix": "Z",
    "label": ["Name"],
    "fields": [
      ["ID", "id"],
      ["Site ID", "ref", "Sites"],
      ["Parent Zone ID", "ref", "Zones"],
      ["Name", "text"],
