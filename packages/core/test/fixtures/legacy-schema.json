{
  "Nodes": {
    "title": "Product Tree",
    "prefix": "N",
    "label": ["Name"],
    "fields": [
      ["ID", "id"],
      ["Parent ID", "ref", "Nodes"],
      ["Type", "enum", ["Group", "Product"]],
      ["Name", "text"],
      ["Code", "text"],
      ["Kind", "lookup", "Product Kind"],
      ["Status", "enum", ["Active", "Deferred", "Inactive"]],
      ["Sort", "num"],
      ["Requires Certification", "lookup", "Certification"],
      ["Markets", "text"],
      ["Default Device Model", "ref", "Device_Models"]
    ],
    "group": "Catalogue"
  },
  "Bundle_Rules": {
    "title": "Bundle Rules",
    "prefix": "BR",
    "label": ["From Product", "Type", "To Product"],
    "fields": [
      ["ID", "id"],
      ["From Product", "ref", "Nodes"],
      ["Type", "enum", ["Includes", "Needs", "Optional"]],
      ["To Product", "ref", "Nodes"]
    ],
    "group": "Catalogue"
  },
  "Features": {
    "title": "App Features",
    "prefix": "F",
    "label": ["Name"],
    "fields": [
      ["ID", "id"],
      ["Group", "lookup", "Feature Group"],
      ["Name", "text"],
      ["Is Command", "yesno"],
      ["Status", "enum", ["Active", "Deferred", "Inactive"]],
      ["Type", "lookup", "Feature Type"]
    ],
    "group": "Catalogue"
  },
  "Product_Features": {
    "title": "Product App Features",
    "prefix": "PF",
    "label": ["Product ID", "Feature ID"],
    "fields": [
      ["ID", "id"],
      ["Product ID", "ref", "Nodes"],
      ["Feature ID", "ref", "Features"],
      ["Availability", "enum", ["Standard", "Optional"]]
    ],
    "group": "Catalogue"
  },
  "Data_Points": {
    "title": "Data Points",
    "prefix": "DP",
    "label": ["Name"],
    "fields": [
      ["ID", "id"],
      ["Name", "text"],
      ["Unit", "text"],
      ["Direction", "enum", ["In", "Out"]]
    ],
    "group": "Catalogue"
  },
  "Feature_Data_Points": {
    "title": "App Feature Data Points",
    "prefix": "FD",
    "label": ["Feature ID", "Data Point ID"],
    "fields": [
      ["ID", "id"],
      ["Feature ID", "ref", "Features"],
      ["Data Point ID", "ref", "Data_Points"],
      ["Required", "yesno"],
      ["Alt Group", "text"]
    ],
    "group": "Catalogue"
  },
  "Interfaces": {
    "title": "Interfaces",
    "prefix": "I",
    "label": ["Name"],
    "fields": [
      ["ID", "id"],
      ["Name", "text"],
      ["Direction", "enum", ["In", "Out", "Both"]],
      ["Medium", "enum", ["Wired", "Wireless"]],
      ["Description", "text"]
    ],
    "group": "Catalogue"
  },
  "Device_Models": {
    "title": "Device Models",
    "prefix": "D",
    "label": ["Maker", "Model"],
    "fields": [
      ["ID", "id"],
      ["Maker", "text"],
      ["Model", "text"],
      ["Type", "lookup", "Device Type"],
      ["Network", "lookup", "Network"],
      ["Own Hardware", "yesno"],
      ["Status", "enum", ["Active", "Deferred", "Inactive"]],
      ["Certifications", "text"],
      ["Placement", "enum", ["On asset", "Site infrastructure"]]
    ],
    "group": "Catalogue"
  },
  "Device_Interfaces": {
    "title": "Device Interfaces",
    "prefix": "DI",
    "label": ["Device Model ID", "Interface ID"],
    "fields": [
      ["ID", "id"],
      ["Device Model ID", "ref", "Device_Models"],
      ["Interface ID", "ref", "Interfaces"],
      ["Count", "num"]
    ],
    "group": "Catalogue"
  },
  "Device_Data_Points": {
    "title": "Device Built-in Data Points",
    "prefix": "DD",
    "label": ["Device Model ID", "Data Point ID"],
    "fields": [
      ["ID", "id"],
      ["Device Model ID", "ref", "Device_Models"],
      ["Data Point ID", "ref", "Data_Points"]
    ],
    "group": "Catalogue"
  },
  "Sensor_Models": {
    "title": "Sensor Models",
    "prefix": "S",
    "label": ["Maker", "Model"],
    "fields": [
      ["ID", "id"],
      ["Maker", "text"],
      ["Model", "text"],
      ["Status", "enum", ["Active", "Deferred", "Inactive"]]
    ],
    "group": "Catalogue"
  },
  "Sensor_Interfaces": {
    "title": "Sensor Interfaces",
    "prefix": "SI",
    "label": ["Sensor Model ID", "Interface ID"],
    "fields": [
      ["ID", "id"],
      ["Sensor Model ID", "ref", "Sensor_Models"],
      ["Interface ID", "ref", "Interfaces"],
      ["Protocol", "text"]
    ],
    "group": "Catalogue"
  },
  "Sensor_Data_Points": {
    "title": "Sensor Data Points",
    "prefix": "SD",
    "label": ["Sensor Model ID", "Data Point ID"],
    "fields": [
      ["ID", "id"],
      ["Sensor Model ID", "ref", "Sensor_Models"],
      ["Data Point ID", "ref", "Data_Points"]
    ],
    "group": "Catalogue"
  },
  "Asset_Types": {
    "title": "Asset Types",
    "prefix": "AT",
    "label": ["Name"],
    "fields": [
      ["ID", "id"],
      ["Name", "text"]
    ],
    "group": "Catalogue"
  },
  "Product_Asset_Types": {
    "title": "Product Asset Types",
    "prefix": "PA",
    "label": ["Product ID", "Asset Type ID"],
    "fields": [
      ["ID", "id"],
      ["Product ID", "ref", "Nodes"],
      ["Asset Type ID", "ref", "Asset_Types"]
    ],
    "group": "Catalogue"
  },
  "Price_Plans": {
    "title": "Price Plans",
    "prefix": "PP",
    "label": ["Product ID", "Sold To"],
    "fields": [
      ["ID", "id"],
      ["Product ID", "ref", "Nodes"],
      ["Sold To", "enum", ["Dealer", "Company"]],
      ["Base Price", "num"],
      ["Period", "enum", ["Month", "Year"]],
      ["Currency", "text"]
    ],
    "group": "Catalogue"
  },
  "Price_Rules": {
    "title": "Price Rules",
    "prefix": "PR",
    "label": ["Rule Type", "Condition"],
    "fields": [
      ["ID", "id"],
      ["Plan ID", "ref", "Price_Plans"],
      [
        "Rule Type",
        "enum",
        [
          "Tier",
          "Quantity band",
          "Asset type",
          "Feature add-on",
          "Item count band",
          "Package discount"
        ]
      ],
      ["Condition", "text"],
      ["Effect", "enum", ["Replace", "Add", "Discount %"]],
      ["Value", "num"]
    ],
    "group": "Catalogue"
  },
  "Hardware_Prices": {
    "title": "Hardware Prices",
    "prefix": "HP",
    "label": ["Model ID", "Sold To", "Supply"],
    "fields": [
      ["ID", "id"],
      ["Model Kind", "enum", ["Device", "Sensor"]],
      ["Model ID", "text"],
      ["Sold To", "enum", ["Dealer", "Company"]],
      ["Supply", "enum", ["Sold", "Rented", "Free with minimum term", "Customer provided"]],
      ["Price", "num"],
      ["Min Term Months", "num"],
      ["Currency", "text"]
    ],
    "group": "Catalogue"
  },
  "Roles": {
    "title": "Roles & Permissions",
    "prefix": "R",
    "label": ["Name"],
    "fields": [
      ["ID", "id"],
      ["Level", "enum", ["Platform", "Dealer", "Company", "User"]],
      ["Name", "text"],
      ["Permissions", "text"]
    ],
    "group": "Catalogue"
  },
  "Role_Features": {
    "title": "Role Feature Access",
    "prefix": "RF",
    "label": ["Role ID", "Feature ID"],
    "fields": [
      ["ID", "id"],
      ["Role ID", "ref", "Roles"],
      ["Feature ID", "ref", "Features"],
      ["Access", "enum", ["Hidden", "View", "Use"]]
    ],
    "group": "Catalogue"
  },
  "Lookups": {
    "title": "Lookups",
    "prefix": "LK",
    "label": ["List", "Value"],
    "fields": [
      ["ID", "id"],
      ["List", "text"],
      ["Value", "text"],
      ["Sort", "num"],
      ["Active", "yesno"]
    ],
    "group": "Catalogue"
  },
  "Certificates": {
    "title": "Vehicle Certificates",
