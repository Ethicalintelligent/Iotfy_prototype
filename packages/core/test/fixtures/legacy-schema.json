      ["ID", "id"],
      ["ICCID", "text"],
      ["Number", "text"],
      ["Operator", "text"],
      ["Owner Dealer ID", "ref", "Dealers"],
      ["Device Unit ID", "ref", "Device_Units"],
      ["Billing", "enum", ["Bundled", "Separate line"]],
      ["Status", "enum", ["In stock", "Active", "Suspended"]]
    ],
    "group": "Business"
  },
  "Sensor_Units": {
    "title": "Sensor Units",
    "prefix": "SU",
    "label": ["Serial"],
    "fields": [
      ["ID", "id"],
      ["Sensor Model ID", "ref", "Sensor_Models"],
      ["Serial", "text"],
      ["Owner Dealer ID", "ref", "Dealers"],
      ["Device Unit ID", "ref", "Device_Units"],
      ["Interface ID", "ref", "Interfaces"],
      ["Slot", "text"],
      ["Calibration", "text"]
