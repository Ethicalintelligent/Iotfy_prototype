      ["Item ID", "text"],
      ["Heading", "text"],
      ["Tier", "lookup", "Tier"],
      ["Asset Type ID", "ref", "Asset_Types"],
      ["Supply", "enum", ["", "Sold", "Rented", "Free with minimum term", "Customer provided"]],
      ["Min Term Months", "num"],
      ["Qty", "num"],
      ["Unit Price", "num"],
      ["Rules Applied", "text"],
      ["Edition Choice", "ref", "Nodes"],
      ["Item Count", "num"],
      ["Package ID", "ref", "Nodes"]
