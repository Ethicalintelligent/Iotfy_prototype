      ["Dealer ID", "ref", "Dealers"],
      ["Name", "text"],
      ["Contact", "text"],
      ["Status", "enum", ["Active", "Suspended"]],
      ["Country", "lookup", "Market"],
      ["Support Access Until", "date"]
